# ============================================================
# HAIST WORKS - Synology NAS 환경변수 예시
# v5H226z75 (2026-05-11)
#
# 실제 사용 시 이 파일을 .env 로 복사 후 값 채우세요.
# 위치: /volume1/docker/knk-haist/.env (NAS 안)
# 절대로 GitHub 에 .env 본 파일 커밋 금지 (.gitignore 등록됨)
# ============================================================

# --- 보안 (필수) ---
# 임의 32+자 문자열. 생성 명령:
#   docker run --rm python:3.11-slim python -c "import secrets; print(secrets.token_hex(32))"
KNK_SECRET_KEY=__여기에_32자_이상_임의_문자열_채우세요__

# --- 운영 모드 ---
# prod  → reload off, https_only 쿠키, workers 다중
# dev   → reload on, http 허용 (NAS에서는 절대 dev 금지)
KNK_MODE=prod

# --- 네트워크 ---
KNK_HOST=0.0.0.0
KNK_PORT=8081
KNK_WORKERS=2

# --- DB / 업로드 경로 (컨테이너 안 경로 — 볼륨 마운트로 영속) ---
# 코드 기본 경로 사용 (변경 시 main.py BASE 경로 정합 필요)
# KNK_DB_PATH=/app/data/knk.db

# --- 시간대 (Dockerfile 에서 Asia/Seoul 고정) ---
TZ=Asia/Seoul

# --- 백업 (선택) ---
# Synology HyperBackup 사용 시 이 값은 무시 가능
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=30

# --- 외부 OCR (선택) ---
# Tesseract 한국어 언어팩은 Dockerfile 에서 자동 설치됨
# pdf2image 의 poppler 도 자동 설치됨
