# ============================================================
# HAIST WORKS — Synology NAS .env 예시
# 실제 .env 는 /volume1/docker/knk-haist/.env 위치
# ============================================================
# 보안: 이 파일은 예시이므로 git 에 포함 OK. 실제 .env 는 절대 git 에 올리지 말 것.
# ============================================================

# --- 운영 모드 (필수) ---
KNK_MODE=prod
KNK_HOST=0.0.0.0
KNK_PORT=8081
KNK_WORKERS=2

# --- 보안 SECRET KEY (필수, 32+ 문자 임의값) ---
# 생성 명령:
#   docker run --rm python:3.11-slim python -c "import secrets; print(secrets.token_hex(32))"
# 또는 NAS SSH:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
KNK_SECRET_KEY=여기에_32자_이상_임의_문자열_채우세요_절대_화면에_출력하지_말것

# --- AI 연동 (선택, 결제 활성 후 추가) ---
# Claude(Anthropic) 또는 OpenAI 둘 다 옵션. 둘 다 비우면 AI 기능 자동 비활성.
KNK_AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 외부 그룹웨어 연동 (선택) ---
# 토큰은 그룹웨어 관리자 페이지 > API 관리 에서 발급.
# 미설정 시 알림은 콘솔에만 출력됨 (silent skip).
HIWORKS_MESSENGER_TOKEN=
HIWORKS_HR_TOKEN=
HIWORKS_APPROVAL_TOKEN=

# --- 로깅·디버그 (운영에서는 비활성 권장) ---
KNK_DEBUG=0

# --- 백업 (선택) ---
# S3 등 외부 백업이 필요 없으면 비워둠 (cron 로컬 백업만 동작)
KNK_BACKUP_S3=
