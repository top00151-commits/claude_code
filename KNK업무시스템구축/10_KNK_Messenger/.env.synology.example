# ============================================================
# KNK Messenger - Synology Docker .env 템플릿
# ============================================================
# 사용법:
#   1. 이 파일을 /volume1/docker/knk-messenger/.env 로 복사
#   2. KNK_MSG_SECRET 을 직접 채우기 (아래 명령 1번 실행)
#      docker run --rm python:3.11-slim python -c "import secrets; print(secrets.token_hex(32))"
#   3. chmod 600 .env (보안)
# ============================================================

# 운영 모드 (production / development)
# - development: dev-on-cloud 단계, 보안헤더 일부 OFF, 친절한 에러
# - production:  최종 운영, HSTS·secure 쿠키·CORS 제한
KNK_MSG_ENV=development

# 내부 포트 (DSM Reverse Proxy 가 이 포트로 프록시)
KNK_MSG_PORT=5050

# 세션 SECRET — 32자 이상 hex. 절대 외부 노출 X
# 생성: docker run --rm python:3.11-slim python -c "import secrets; print(secrets.token_hex(32))"
KNK_MSG_SECRET=__CHANGE_ME_TO_64_HEX_CHARS__

# 메시지 보존 개월 (이후 자동 삭제, keep_forever 토글 방은 제외)
KNK_MSG_RETENTION_MONTHS=12

# Socket.IO async_mode (gunicorn 워커가 eventlet)
KNK_MSG_ASYNC=eventlet

# CORS allowed origins (Synology Reverse Proxy 사용 시 도메인 1개로 제한)
# dev 단계: * 로 시작 → 운영 전환 시 실제 도메인으로
KNK_MSG_CORS=https://msg.knknara.co.kr

# VAPID 푸시 contact (Let's Encrypt 와 동일 이메일)
KNK_MSG_CONTACT=mailto:admin@knknara.co.kr

# 신뢰할 프록시 수 (DSM Reverse Proxy 1대)
KNK_MSG_PROXIES=1

# Admin 토큰 — cron이 cleanup 엔드포인트 호출용. 32자 hex 권장.
# 생성: docker run --rm python:3.11-slim python -c "import secrets; print(secrets.token_hex(32))"
KNK_MSG_ADMIN_TOKEN=__CHANGE_ME_64_HEX__

# 시드 사용자 임시 비밀번호 (운영 시작 후 첫 로그인 시 강제 변경됨)
# 비워두면 'knk1234' 사용 (경고 출력)
KNK_MSG_SEED_PASSWORD=

# 로그인 무차별 대입 방어
KNK_MSG_LOGIN_FAIL_LIMIT=5
KNK_MSG_LOGIN_LOCK_SECONDS=300

# 메시지 송신 rate limit
KNK_MSG_RATE_PER_SEC=5
KNK_MSG_RATE_BURST=10

# === AI 번역 (Claude Haiku) ===
# 활성화하려면 ANTHROPIC_API_KEY 입력. https://console.anthropic.com 에서 발급.
# 비워두면 번역 기능 자동 OFF (앱은 정상 동작).
ANTHROPIC_API_KEY=
# 모델 (기본: claude-haiku-4-5 — 짧은 번역에 가장 저렴)
KNK_MSG_TRANSLATE_MODEL=claude-haiku-4-5
# 월 비용 한도 (USD). 초과 시 신규 번역 차단, 캐시는 계속 동작.
KNK_MSG_TRANSLATE_USD_LIMIT=20

# === 대용량 파일 ===
# 업로드 최대 (MB). DWG·동영상 대비 500. nginx client_max_body_size 와 같이 키워야.
KNK_MSG_MAX_UPLOAD_MB=500

# (선택) 백업을 외부로 보내고 싶을 때 — Synology 사용자는 보통 HyperBackup 으로 처리
# KNK_BACKUP_S3=s3://knk-messenger-backup/
