REM === .env auto-load (OPENAI_API_KEY / ANTHROPIC_API_KEY etc.) ===
REM Read KEY=VALUE lines from .env and set as env vars.
REM Note: lines starting with # become a no-op env var (harmless).
if exist ".env" (
  echo  [info] .env loaded
  for /f "usebackq eol=# tokens=1,* delims==" %%a in (".env") do (
    if not "%%a"=="" set "%%a=%%b"
  )
)
REM AI translation status - check OPENAI first, then ANTHROPIC
if defined OPENAI_API_KEY goto :ai_openai
if defined ANTHROPIC_API_KEY goto :ai_anthropic
echo  [info] AI translation: OFF  (run OpenAI키설정.bat to enable)
