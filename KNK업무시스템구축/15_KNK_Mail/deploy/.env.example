# KNK Eum MAIL 운영 환경변수 — 이 파일을 deploy/.env 로 복사 후 값 채우기.
# (deploy/.env 는 .gitignore 로 git 에 안 올라감 — 비밀값 안전)

# 데이터/DB (NAS 영구 볼륨 경로로)
KNK_MAIL_DATA=/volume1/web/knk-eum-mail/data
KNK_MAIL_DB=/volume1/web/knk-eum-mail/data/mail.db

# 외부 공개 주소 (리버스프록시가 가리킬 주소)
KNK_MAIL_PUBLIC_BASE=https://mail.knknara.co.kr
KNK_MAIL_HTTPS_ONLY=1
KNK_MAIL_PORT=8201

# 세션 서명키 — 반드시 길고 무작위로 (예: python -c "import secrets;print(secrets.token_urlsafe(48))")
KNK_MAIL_SESSION_SECRET=__여기에_무작위_긴_문자열__

# 메신저 SSO (WORKS 와 동일 메신저)
KNK_MAIL_SSO_AUDIENCE=knk-mail
KNK_MESSENGER_SSO_BASE=https://haist.knknara.co.kr/msg
# 직원명부 동기화 서버키 — 메신저와 동일 값 (메신저 SSO 요청서 참고)
KNK_SSO_SERVICE_KEY=__메신저와_공유__

# 메일 비번 암호화(Fernet). 미설정 시 data 폴더에 자동 키파일 생성(가능하나 env 권장)
# 생성: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
KNK_MAIL_KEY=__Fernet_키__

# AI 요약·번역(선택) — 둘 중 하나
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 운영에서는 절대 1 로 두지 말 것(로컬 개발 전용 로그인 우회)
KNK_MAIL_DEV_LOGIN=0
